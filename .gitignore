# Dependencies
node_modules/
**/node_modules/

# Build / framework output
.nuxt/
.output/
dist/
.cache/

# Logs
*.log

# Temp files generated by deploy.js (cleaned up on success; gitignored as safety net)
Dockerfile.*.build
cloudbuild.*.yaml

# OS / editor
.DS_Store
**/.DS_Store
*.swp
.idea/
.vscode/

# Generated at deploy time by predeploy hook; never committed
functions/.env
functions/.env.*

# Temporary and one off scripts and files
.scratch

# NOTE: .env files are intentionally NOT ignored (private repo).

# Local-only dumps and generated indexes — never source control.
.backups/
.backup/
.codegraph/
