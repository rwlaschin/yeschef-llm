# ============================================================
# Production only - overrides .env
# ============================================================

GCP_PROJECT_ID=yeschef-c572a
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_SERVICE_ACCOUNT=yeschef-worker@yeschef-c572a.iam.gserviceaccount.com
MONGO_URI=mongodb+srv://rwuser:UNDERDOG*dish9consort@yeschef-development.vfmtkz4.mongodb.net/?appName=YesChef-Development
MONGO_DB=yeschef
# SUBSCRIPTION_NAME and OLLAMA_MODEL are injected per-service by deploy.js

# Queue depth is deploy-wide. Generation capacity is declared per model in config/models.js.
OLLAMA_MAX_QUEUE=5

# Deploy/error alerting → #alerts (Incoming Webhook).
# Cloud Monitoring alert policies POST here indirectly via monitoring/slack-relay (Cloud Run) —
# Monitoring's own webhook JSON schema (1.2) doesn't match what Slack expects, so the relay
# reformats it and adds Debug/Disable links. Redeploy the relay: cd monitoring/slack-relay &&
# gcloud run deploy slack-relay --source=. (reuses these same env vars if unchanged).
SLACK_ALERTS_WEBHOOK=https://hooks.slack.com/services/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
# Shared secret the notification channel appends as ?token=... on the relay URL (webhook_tokenauth
# channels only support a plain URL, no auth-header field — see monitoring/slack-relay/index.js).
SLACK_RELAY_TOKEN=b6eeaf1ed743a9597d129002b7acf185edeff34d460c8a2b
SLACK_RELAY_URL=https://slack-relay-ouqnjncjwa-uc.a.run.app
