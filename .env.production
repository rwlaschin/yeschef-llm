MONGO_DB=yeschef_prod
# SUBSCRIPTION_NAME and OLLAMA_MODEL are injected per-service by deploy.js

# Ollama concurrency knobs — read by deploy.js, baked into each model image's ENV AND passed as
# `docker run -e` in the VM startup. Retune here, then redeploy the workers. (Overrides .env.)
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_QUEUE=5
