            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 36,
        "yPos": 12,
        "width": 12,
        "height": 9,
        "widget": {
          "title": "Monthly Cost — yeschef-llm (USD, 30d)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"custom.googleapis.com/billing/cost_by_service_usd\" AND metric.label.\"service\"=\"Compute Engine\"",
                "aggregation": {
                  "alignmentPeriod": "2592000s",
                  "perSeriesAligner": "ALIGN_SUM",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            }
          }
        }
      },
      {
        "yPos": 21,
        "width": 16,
        "height": 10,
        "widget": {
          "title": "Deploys in progress",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
