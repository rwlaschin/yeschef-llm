                        "metric.label.\"phase\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.label.phase}",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "seconds",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 36,
        "width": 12,
        "height": 12,
