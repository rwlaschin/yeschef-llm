      {
        "xPos": 16,
        "yPos": 21,
        "width": 16,
        "height": 20,
        "widget": {
          "title": "Uptime by Machine (minutes, log)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "label_replace(max by (machine, zone) (label_replace(compute_googleapis_com:instance_uptime_total{monitored_resource=\"gce_instance\",instance_name!~\".*-baker-.*\"}, \"machine\", \"$1\", \"instance_name\", \"(?:ollama-)?([a-z0-9-]+?)-v[0-9]+.*\")) / 60, \"stat\", \"max\", \"\", \"\")"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "label_replace(avg by (machine, zone) (label_replace(compute_googleapis_com:instance_uptime_total{monitored_resource=\"gce_instance\",instance_name!~\".*-baker-.*\"}, \"machine\", \"$1\", \"instance_name\", \"(?:ollama-)?([a-z0-9-]+?)-v[0-9]+.*\")) / 60, \"stat\", \"mean\", \"\", \"\")"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "label_replace(min by (machine, zone) (label_replace(compute_googleapis_com:instance_uptime_total{monitored_resource=\"gce_instance\",instance_name!~\".*-baker-.*\"}, \"machine\", \"$1\", \"instance_name\", \"(?:ollama-)?([a-z0-9-]+?)-v[0-9]+.*\")) / 60, \"stat\", \"min\", \"\", \"\")"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "uptime (minutes)",
              "scale": "LOG10"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
