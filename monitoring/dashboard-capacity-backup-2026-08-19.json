                  "alignmentPeriod": "3600s",
                  "perSeriesAligner": "ALIGN_MEAN",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            },
            "gaugeView": {
              "upperBound": 10
            },
            "thresholds": [
              {
                "value": 1,
                "color": "YELLOW",
                "direction": "ABOVE"
              },
              {
                "value": 5,
                "color": "RED",
                "direction": "ABOVE"
              }
            ]
          }
        }
      },
