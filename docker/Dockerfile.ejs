# ============================================================
# Image: <%= name %>
# Model: <%= model %>
# GPU: <%= gpu %>x NVIDIA L4
# ============================================================

<% if (typeof baseImage !== 'undefined' && baseImage) { %>
# Prod: baseImage is the shared, pre-built ollama-base (see docker/Dockerfile.base +
# scripts/deploy.js ensureBaseImage) — avoids re-running apt-get/node-install per model.
FROM <%= baseImage %>
<% } else { %>
FROM ollama/ollama:latest

# Node 22 (OpenClaw requires >=22.19) + git (OpenClaw self-install needs it).
# DEBIAN_FRONTEND=noninteractive: a transitive tzdata dep otherwise prompts for a
# geographic area and hangs the (non-TTY) Cloud Build. Container TZ stays UTC.
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y curl git && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y nodejs && \
    apt-get clean
<% } %>
<% if (gateway === 'openclaw') { %>
# OpenClaw gateway tier: bake the CLI so cold starts don't re-download it (~82MB).
RUN npm install -g openclaw
<% } %>

WORKDIR /app

# Store models OUTSIDE /root/.ollama: the base ollama image declares that path as
# a VOLUME, and Docker discards build-time writes to volume paths — so pulling
# there leaves the model OUT of the image (cold starts would re-pull GBs every
# time). /models is a normal layer, so the baked model persists. This ENV also
# applies at runtime, so `ollama serve` reads the baked model from the same path.
ENV OLLAMA_MODELS=/models

# Pull the model EARLY — BEFORE copying app code — so editing worker/ or config/
# does NOT invalidate this expensive (multi-GB) layer. Docker's cache key for this
# RUN includes the `<%= model %>` text, so it still re-pulls correctly when the
# model tag itself changes — just not on every worker code edit.
# IMPORTANT: a failed `ollama pull` MUST fail the build (don't mask it with
# `|| true`, or you ship a model-less image that "built fine"). The `|| true`
# is scoped to pkill only. After pull, assert the model is actually present.
RUN ollama serve & \
    sleep 10 && \
    for i in {1..30}; do \
      curl -sf http://localhost:11434/api/tags >/dev/null && break || sleep 2; \
    done && \
    ollama pull <%= model %> && \
    ollama list | grep -q "<%= model %>" && \
    { pkill -f "ollama serve" || true; } && \
    sleep 2

# App code LAST — these layers are cheap and change often, so a worker/config edit
# rebuilds in seconds and REUSES the baked-model layer above. npm install keys off
# package.json alone (copied first), so code edits don't trigger a reinstall either.
COPY package.json ./
RUN npm install
COPY worker/ ./worker/
COPY config/ ./config/
COPY docker/common/start.sh /start.sh
RUN chmod +x /start.sh

ENV OLLAMA_MODEL=<%= model %>
ENV OLLAMA_HOST=http://localhost:11434
ENV OLLAMA_NUM_PARALLEL=<%= parallel %>
ENV OLLAMA_MAX_QUEUE=<%= maxQueue %>
ENV SUBSCRIPTION_NAME=<%= subscription %>

# The ollama base image sets ENTRYPOINT ["ollama"]; clear it so /start.sh runs
# (otherwise CMD becomes `ollama /start.sh` → "unknown command").
ENTRYPOINT []
CMD ["/start.sh"]
