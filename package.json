{
  "name": "ollama-infra",
  "version": "1.0.0",
  "description": "GCP infrastructure scripts for Ollama LLM deployment",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:firestore": "node scripts/setup-firestore-ttl.js",
    "dev": "cross-env NODE_ENV=dev node scripts/dev.js",
    "dev:quick": "cross-env NODE_ENV=dev DEV_QUICK=1 node scripts/dev.js",
    "kill:emulators": "node scripts/kill-emulators.js",
    "test": "node --test \"worker/**/*.test.js\" \"functions/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" --test-coverage-lines=90 --test-coverage-functions=80 --test-coverage-branches=60 \"worker/**/*.test.js\"",
    "deploy": "node scripts/deploy-all.js",
    "deploy:workers": "cross-env NODE_ENV=production node scripts/deploy.js",
    "deploy:workers:spot": "cross-env NODE_ENV=production node scripts/deploy.js --spot",
    "images": "cross-env NODE_ENV=production node scripts/audit-images.mjs",
    "deploy:orchestrator": "firebase deploy --only functions:orchestrator",
    "deploy:relay": "cross-env NODE_ENV=production node scripts/deploy-relay.js",
    "rollback": "cross-env NODE_ENV=production node scripts/rollback.js",
    "kill:workers": "bash scripts/kill-workers.sh",
    "restore:workers": "bash scripts/restore-workers.sh"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.0.0",
    "cross-env": "^7.0.3",
    "dotenv-flow": "^4.1.0",
    "duck-duck-scrape": "^2.2.7",
    "ejs": "^3.1.8",
    "firebase-admin": "^13.10.0",
    "mongodb": "^6.0.0",
    "yaml": "^2.9.0"
  }
}
