import { getCollection } from '../../utils/db'
// '~/utils/…', not a relative climb: Nitro rewrites relative paths when it bundles into .nuxt/dev,
// and '../../../utils/assemblePrompt' resolved to /Users/<you>/Documents/utils/assemblePrompt at
// RUNTIME — a 500 on this endpoint. The Vue components have always used the '~' form.
import { assembleFull, withMarkers } from '~/utils/assemblePrompt'

// The assembled prompt for a message type — what the worker actually builds.
//
// Fragments now carry a `relatesTo` naming where in the step they are placed, so the system prompt
// alone is no longer the whole picture: a `{pass}`-anchored fragment has no position except relative
// to a step's Pass criteria. Pass `?step=<plan_library name>` to see the full pair.
//
// Without a step there is nothing to place against, so every fragment falls back to the system
// message — byte-identical to what this endpoint returned before placement existed, and to what the
// worker does with an instruction that carries no markers.
//
// Returns a string when no step is given (unchanged for existing callers), or { system, instructions }
// when one is.
export default defineEventHandler(async (event) => {
  const q = getQuery(event)
  const type = String(q.type || '')
  const stepName = String(q.step || '')
  if (!type) return ''

  const col = await getCollection('prompt_library')
  const prompts = await col.find({ isDeleted: { $ne: true } }).toArray()

  if (!stepName) return assembleFull(prompts, type, '', { includeInactive: true }).system

  // The step's OWN rendered text is what the markers live in. Read the template rather than a
  // composed plan: the preview is for authoring, so it must show the current record, not a job's
  // frozen copy.
  const steps = await getCollection('plan_library')
  const step = await steps.findOne({ name: stepName })
  if (!step) return { system: assembleFull(prompts, type, '', { includeInactive: true }).system, instructions: '', missingStep: stepName }

  // Mirrors compose.js renderUnit's marker layout. Handlebars is NOT rendered here — an authoring
  // preview shows the template as authored; `{{days}}` stays visible so the author can see it.
  const raw = withMarkers(step.instruction, step.pass, step.fail)
  const { system, instructions } = assembleFull(prompts, type, raw, { includeInactive: true })
  return { system, instructions }
})
