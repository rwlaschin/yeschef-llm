import pino from "pino";

let logger: ReturnType<typeof pino> | null = null;

// localStorage fires `storage` only in OTHER tabs, so a same-tab write is invisible to listeners.
// The transport announces writes on this event instead — that is what lets the viewer drop polling.
const LOCAL_LOG_EVENT = "yeschef-llm-logs:written";

export const useLogger = (name: string) => {
  if (process.server) {
    return {
      info: () => {},
      error: () => {},
      warn: () => {},
      debug: () => {},
    };
  }

  if (!logger) {
    // Custom localStorage transport for Pino
    const localStorageTransport = {
      write(chunk: string) {
        try {
          const logs = JSON.parse(
            localStorage.getItem("yeschef-llm-logs") || "[]"
          );
          const log = JSON.parse(chunk);
          logs.push({
            ...log,
            timestamp: new Date().toISOString(),
          });

          // Keep only last 100 logs
          if (logs.length > 100) {
            logs.shift();
          }

          localStorage.setItem("yeschef-llm-logs", JSON.stringify(logs));
          window.dispatchEvent(new CustomEvent(LOCAL_LOG_EVENT));
        } catch (err) {
          console.error("Failed to write to localStorage:", err);
        }
      },
    };

    logger = pino(
      {
        level: "info",
        base: { module: name },
        transport: {
          target: "pino/browser",
          options: {
            write: localStorageTransport.write,
          },
        },
      }
    );
  }

  return logger.child({ module: name });
};


// ── logd: the local dev log collector (tools/logd in yeschef-orders) ─────────────────────────
// Keeps a per-component ring buffer ON DISK, so unlike the localStorage source above it survives
// a page reload, a dev-server crash, and its own restart. Not running is a normal state — the
// picker falls back to this dashboard's own logs and nothing errors.
//
// Nothing here polls. Backfill once over HTTP, then SSE carries every subsequent line; logd also
// pushes a frame when a new component appears, so the source list stays current on its own.
const LOGD_URL = "http://localhost:4319";
export const LOCAL_SOURCE = "dashboard";
export const ALL_SOURCE = "All";
// Cloud Logging — prod's only log surface. Kept a source of its own rather than folded into
// ALL_SOURCE: reads are quota-limited per minute, so it must only be hit while actually selected.
const CLOUD_POLL_MS = 15000;

// logd levels are strings; the viewer speaks pino's numeric levels.
const LEVEL_NUM: Record<string, number> = { trace: 10, debug: 20, info: 30, warn: 40, error: 50, fatal: 60 };
const MAX_LINES = 1000;   // ring the client holds; unbounded growth would sink the page

// logd forwards an NDJSON shipper's `level` verbatim as a string (server.mjs: `String(o.level)`), so
// a pino shipper yields "30" and a Google-style one "INFO" — both missed this lowercase table and
// silently became 30, which flattened every line to INF and made the level filter look inert.
const toLevel = (v: unknown): number => {
  if (typeof v === "number") return v;
  const s = String(v ?? "").trim().toLowerCase();
  return s && Number.isFinite(Number(s)) ? Number(s) : (LEVEL_NUM[s] ?? 30);
};

export interface LogLine {
  level: number;
  timestamp: string;
  msg: string;      // escape-free — what search and filtering run against
  raw?: string;     // original terminal output, colour codes intact — what the viewer renders
  module: string;
  seq: number;      // stable identity, so v-for keys don't churn as the window slides
  id?: string;      // Cloud Logging insertId — dedupes the overlap between polls
}

let localSeq = 0;
const toLine = (l: any, component: string): LogLine => ({
  level: toLevel(l.level),
  timestamp: new Date(l.ts).toISOString(),
  msg: l.msg,
  raw: l.raw,
  module: l.module || l.component || component,
  seq: l.seq ?? ++localSeq,
  id: l.id,
});

/** Every selectable source for the CURRENT environment: the picker is the same control in both, only
 * what fills it changes — logd components locally, Cloud Run/GCE service names in production. Which
 * backend answers is the app-wide env toggle's call (useEnvironment), exactly like every other panel;
 * "production" is not a source you pick. */
export const useLogdSources = () => {
  const { env } = useEnvironment();
  const sources = ref<string[]>([ALL_SOURCE, LOCAL_SOURCE]);
  const known = ref<string[]>([]);
  let es: EventSource | null = null;

  const rebuild = () => {
    sources.value = env.value === "production"
      ? [ALL_SOURCE, ...[...new Set(known.value)].sort()]         // no local dashboard logs in prod
      : [ALL_SOURCE, LOCAL_SOURCE, ...[...new Set(known.value)].sort()];
  };

  // Prod services aren't enumerable up front — Cloud Logging has no "list my services" call — so they
  // are learned from the log lines themselves and accumulate as new ones appear.
  const loadCloud = async () => {
    try {
      // Deliberately SMALL: this only needs the set of service names, and asking for a full page here
      // doubled every page load's Cloud Logging reads (1000 here + 500 in useLogs), which is what kept
      // tripping the per-minute read quota and blanking the panel. A short sample names the services.
      const res = await fetch(`/api/logs/cloud?env=production&n=100`);
      const { lines = [] } = await res.json();
      known.value = [...new Set(lines.map((l: any) => l.module).filter(Boolean))] as string[];
    } catch {
      known.value = [];
    }
    rebuild();
  };

  const loadLogd = async () => {
    try {
      const res = await fetch(`${LOGD_URL}/components`);
      const { components } = await res.json();
      known.value = components.map((c: any) => c.component);
    } catch {
      known.value = [];   // collector down — degrade quietly
    }
    rebuild();
  };

  const load = () => (env.value === "production" ? loadCloud() : loadLogd());

  const watchLogd = () => {
    // EventSource reconnects by itself, so a logd restart re-attaches with no help from us.
    es = new EventSource(`${LOGD_URL}/stream`);
    es.onmessage = (e) => {
      const { component } = JSON.parse(e.data);
      if (component && !known.value.includes(component)) {
        known.value = [...known.value, component];
        rebuild();
      }
    };
  };

  onMounted(() => {
    load();
    if (env.value !== "production") watchLogd();
  });
  // Flipping the toggle re-populates the picker and drops the logd watcher, which has nothing to say
  // about prod.
  watch(env, (e) => {
    es?.close(); es = null;
    known.value = [];
    load();
    if (e !== "production") watchLogd();
  });
  onBeforeUnmount(() => es?.close());

  return { sources, reload: load };
};

/** Logs for the selected source, from whichever backend the app-wide env toggle points at: Cloud
 * Logging (polled) in production, logd/localStorage (streamed) locally. */
export const useLogs = (source: Ref<string>) => {
  const { env } = useEnvironment();
  // shallowRef: the array is replaced wholesale on each flush, and Vue must NOT walk thousands of
  // line objects making them deeply reactive — that alone was a large part of the cost.
  const logs = shallowRef<LogLine[]>([]);
  // Tri-state: null = no verdict yet (first poll/handshake in flight). Only a real failure sets
  // false — starting at false made the status bar claim "unreachable" for the whole first load.
  const connected = ref<boolean | null>(null);
  let es: EventSource | null = null;

  // Incoming lines are buffered and applied one frame at a time. Reacting per line meant a fresh
  // MAX_LINES array, a full re-filter and a full re-render for EVERY line — at a few hundred
  // lines/sec (turbopack + emulator chatter) that saturates the main thread and locks the tab.
  let pending: LogLine[] = [];
  let timer: ReturnType<typeof setInterval> | null = null;
  const FLUSH_MS = 250;

  const flush = () => {
    if (!pending.length) return;
    const next = logs.value.concat(pending);
    pending = [];
    logs.value = next.length > MAX_LINES ? next.slice(-MAX_LINES) : next;
  };

  const startFlushing = () => { if (!timer) timer = setInterval(flush, FLUSH_MS); };
  const stopFlushing = () => { if (timer) { clearInterval(timer); timer = null; } pending = []; };

  // Cloud Logging polling state — reset whenever the source changes.
  let poller: ReturnType<typeof setInterval> | null = null;
  let seen = new Set<string>();
  let since = "";

  const stop = () => {
    es?.close(); es = null;
    if (poller) { clearInterval(poller); poller = null; }
    connected.value = null;
    stopFlushing();
  };

  const loadLocal = () => {
    try {
      const stored = localStorage.getItem("yeschef-llm-logs");
      logs.value = stored ? JSON.parse(stored).map((l: any) => ({ ...l, level: toLevel(l.level) })) : [];
    } catch (err) {
      console.error("Failed to load logs:", err);
    }
  };

  // A picked prod source is a service name, which `module` derives from either label — so the filter
  // has to accept both or selecting e.g. `gce_instance` would return nothing.
  const cloudFilter = () => {
    const s = source.value;
    return s === ALL_SOURCE
      ? ""
      : `(resource.labels.service_name="${s}" OR resource.type="${s}")`;
  };

  const pollCloud = async () => {
    try {
      const f = cloudFilter();
      // First load needs a full page; every poll after it is anchored to `since` and only ever returns
      // the last few seconds, so asking for 500 there burned the per-minute read quota for nothing —
      // observed tripping it live and blanking the panel until the next tick.
      const res = await fetch(`/api/logs/cloud?env=production&n=${since ? 200 : MAX_LINES / 2}`
        + `${since ? `&since=${encodeURIComponent(since)}` : ""}${f ? `&filter=${encodeURIComponent(f)}` : ""}`);
      const { lines = [] } = await res.json();
      connected.value = true;
      const fresh = lines.filter((l: any) => l.id && !seen.has(l.id));
      // Anchor the next poll. Rewound a minute behind the newest line because ingestion lag lets an
      // entry be indexed after we have polled past its timestamp (insertId dedupe absorbs the
      // overlap), but never further back than 5 minutes — re-scanning the wide first-load window
      // every 15s would burn the per-minute read quota on an idle project.
      since = new Date(Math.max(
        fresh.length ? new Date(fresh[fresh.length - 1].ts).getTime() - 60_000 : 0,
        Date.now() - 5 * 60_000,
      )).toISOString();
      if (!fresh.length) return;
      for (const l of fresh) seen.add(l.id);
      pending.push(...fresh.map((l: any) => toLine(l, source.value)));
      flush();
      // insertIds only need to outlive the ring they dedupe against.
      if (seen.size > MAX_LINES * 2) seen = new Set(logs.value.map((l) => l.id!).filter(Boolean));
    } catch {
      connected.value = false;
    }
  };

  const subscribe = (path: string, component: string) => {
    stop();
    es = new EventSource(`${LOGD_URL}${path}`);
    es.onopen = () => { connected.value = true; };
    es.onerror = () => { connected.value = false; };   // EventSource retries on its own
    es.onmessage = (e) => {
      pending.push(toLine(JSON.parse(e.data), component));
      // Hard cap the buffer too: a burst between frames must not grow without bound.
      if (pending.length > MAX_LINES) pending = pending.slice(-MAX_LINES);
    };
    startFlushing();
  };

  const load = async () => {
    const s = source.value;
    // The env toggle — not the source picker — decides WHICH backend answers, same as every other
    // panel in this dashboard. In production that is Cloud Logging for every source; logd only ever
    // holds local dev output, so there is nothing of its to show.
    if (env.value === "production") {
      stop();
      logs.value = []; seen = new Set(); since = "";
      await pollCloud();
      poller = setInterval(pollCloud, CLOUD_POLL_MS);
      return;
    }
    if (s === LOCAL_SOURCE) { stop(); return loadLocal(); }
    const isAll = s === ALL_SOURCE;
    try {
      const res = await fetch(`${LOGD_URL}${isAll ? `/logs-all?n=${MAX_LINES}` : `/logs/${s}?n=${MAX_LINES}`}`);
      const { lines } = await res.json();
      logs.value = lines.map((l: any) => toLine(l, s));      // backfill first…
    } catch {
      logs.value = [];
    }
    subscribe(isAll ? "/stream-all" : `/stream/${s}`, s);     // …then stream the tail
  };

  const clearLogs = async () => {
    const s = source.value;
    if (env.value !== "production" && s === LOCAL_SOURCE) {
      localStorage.removeItem("yeschef-llm-logs");
    } else if (env.value !== "production" && s !== ALL_SOURCE) {
      await fetch(`${LOGD_URL}/logs/${s}`, { method: "DELETE" }).catch(() => {});
    }
    // ALL clears the view only — it must not wipe every component's history. Cloud Logging is
    // read-only anyway, and its dedupe set survives, so a cleared view stays cleared.
    logs.value = [];
  };

  // Same-tab localStorage writes fire no `storage` event, so the transport announces its own.
  const onLocalWrite = () => { if (source.value === LOCAL_SOURCE) loadLocal(); };

  onMounted(() => {
    load();
    window.addEventListener(LOCAL_LOG_EVENT, onLocalWrite);
    window.addEventListener("storage", onLocalWrite);   // other tabs
  });
  onBeforeUnmount(() => {
    stop();
    window.removeEventListener(LOCAL_LOG_EVENT, onLocalWrite);
    window.removeEventListener("storage", onLocalWrite);
  });
  // Flipping the env toggle switches backends mid-session, so the ring must be dropped: prod lines and
  // local lines share no numbering and mixing them would read as one stream.
  watch([source, env], () => { logs.value = []; load(); });

  return { logs, clearLogs, reload: load, connected };
};
