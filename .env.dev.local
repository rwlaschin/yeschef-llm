# e2e/local-env branch — every value here is 100% local/non-prod. dotenv-flow loads this file
# LAST (highest priority) when NODE_ENV=dev, so it overrides .env.dev's real Atlas/Aura/GCP values
# without editing that tracked file. Committed on this branch only — see
# docs/plans/e2e-local-env/plan.md and .gitattributes (.env.dev.local merge=ours).

GCP_PROJECT_ID=yeschef-e2e
FIREBASE_PROJECT_ID=yeschef-e2e
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=localhost:8700
FIREBASE_AUTH_EMULATOR_HOST=localhost:9700

# Same local Mongo instance + database as heychef's .env.local (MONGODB_URI/MONGODB_DB) — in prod
# this is the SAME Atlas cluster/database (see .env.dev's comment: plan_library/prompt_library
# live alongside companies/entities/... in `yeschef`), so local mirrors that topology.
MONGO_URI=mongodb://localhost:27018
MONGO_DB=yeschef_e2e
MONGO_COLLECTION=rag_e2e

NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=e2e-local-only

OLLAMA_MODEL=canned
